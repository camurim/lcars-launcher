{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lcars-launcher.local/schemas/layout_sync.schema.json",
  "title": "LAYOUT_SYNC Payload",
  "type": "object",
  "required": ["direction", "layout_version", "updated_at", "profile_name", "grid", "pages"],
  "properties": {
    "direction": {
      "type": "string",
      "enum": ["push", "pull_request", "pull_response"]
    },
    "layout_version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "grid": {
      "type": "object",
      "required": ["columns", "rows", "orientation"],
      "properties": {
        "columns": { "type": "integer", "minimum": 2, "maximum": 12 },
        "rows": { "type": "integer", "minimum": 2, "maximum": 12 },
        "orientation": { "type": "string", "enum": ["landscape", "portrait"] }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "accent_color", "blocks"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "accent_color": {
            "type": "string",
            "enum": ["amber", "peach", "lavender", "cyan", "gold", "red_alert"]
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "block_type", "label", "col", "row", "col_span", "row_span", "color_token"],
              "properties": {
                "id": { "type": "string" },
                "block_type": { "type": "string", "enum": ["action", "info"] },
                "label": { "type": "string" },
                "col": { "type": "integer", "minimum": 0 },
                "row": { "type": "integer", "minimum": 0 },
                "col_span": { "type": "integer", "minimum": 1 },
                "row_span": { "type": "integer", "minimum": 1 },
                "color_token": {
                  "type": "string",
                  "enum": ["amber", "peach", "lavender", "cyan", "gold", "red_alert"]
                },
                "action_id": { "type": "string" },
                "source": { "type": "string", "enum": ["pc_telemetry", "local_device"] },
                "metric_key": { "type": "string" },
                "display_format": { "type": "string", "enum": ["value", "bar", "sparkline", "gauge", "clock"] },
                "alarm_mode": { "type": "string", "enum": ["none", "visual", "sound", "both"] },
                "alarm_min": { "type": ["number", "null"] },
                "alarm_max": { "type": ["number", "null"] }
              },
              "allOf": [
                {
                  "if": { "properties": { "block_type": { "const": "action" } } },
                  "then": { "required": ["action_id"] }
                },
                {
                  "if": { "properties": { "block_type": { "const": "info" } } },
                  "then": { "required": ["source", "metric_key"] }
                }
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
